# Cloudflare Pages response headers.
# https://developers.cloudflare.com/pages/configuration/headers/

# Content-Security-Policy is in Report-Only mode: nothing is blocked, the
# browser only logs violations to the DevTools console. Once a week of normal
# use shows no violations (GA4 after consent, booking form), rename the header
# to Content-Security-Policy to enforce it.
#
# The two sha256 values are the inline GA4 scripts in every page's <head>:
# the Consent Mode default, and the gtag('config') block that consent.js
# activates. If either is edited (e.g. a new GA4 ID), recompute the hash
# (DevTools prints the expected value in the violation message) or analytics
# will stop once the policy is enforced.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'sha256-awNwftkFhSNXZrhgDG69/1RnQVunbGtr7eCKBSD0oN8=' 'sha256-+lKMRxmANbNBP+Q+8HuUwv3tpILGhHNyuK+6AULvU5A=' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com https://pagead2.googlesyndication.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://pagead2.googlesyndication.com; media-src 'self'; frame-src 'none'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'

# Photography and brand assets change rarely. Filenames are NOT content-hashed,
# so no `immutable` here — a week of caching with revalidation means a replaced
# photo goes live without visitors being stuck on a stale copy for a year.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Fonts are content-hashed by filename in practice — a weight never changes
# once shipped — so they can be cached hard and marked immutable.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
